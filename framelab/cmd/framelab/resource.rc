FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Night City Frame Lab"
      VALUE "FileDescription", "Night City Frame Lab"
      VALUE "FileVersion", "2.0.0"
      VALUE "ProductName", "Night City Frame Lab"
      VALUE "ProductVersion", "2.0.0"
      VALUE "OriginalFilename", "NightCityFrameLab.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
